# Copy to .env.review.local (gitignored). Used only by `npm run review`; never put this key in the app's .env.
# SUPABASE_URL: the project to review (http://127.0.0.1:54321 for the local stack).
# SUPABASE_SERVICE_ROLE_KEY: Supabase Dashboard → Project Settings → API Keys → secret (service_role) key.
SUPABASE_URL=
