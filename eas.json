{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/release/*"
      ]
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/release/*"
      ]
    }
  },
  "submit": {
    "production": {}
  }
}
