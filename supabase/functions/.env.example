# Secretos de las Edge Functions (NUNCA en la app ni con prefijo EXPO_PUBLIC_).
# Local:      copiar a supabase/functions/.env y usar `supabase functions serve --env-file supabase/functions/.env`
# Producción: `supabase secrets set MODEL_API_KEY=...`
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Secreto compartido con el trabajo programado de la base (pg_cron) que llama a `notify`
# con el evento `sweep` en el encabezado x-convia-cron. Debe ser igual al secreto
# `convia_cron_secret` del Vault. Sin él, `notify` rechaza el barrido (401).
CRON_SECRET=

# verify-vehicle: intentos por conductor en 24 horas (por defecto 20). Además hay un tope fijo de 10 por hora.
# VERIFY_VEHICLE_MAX_PER_DAY=20

# Solo local o staging: con ALLOW_MOCK=true y sin MODEL_API_KEY, las funciones de IA
# responden con resultados simulados. Sin esta variable fallan cerradas (503 MODEL_UNAVAILABLE).
# NUNCA configurarla en producción.
# ALLOW_MOCK=true
